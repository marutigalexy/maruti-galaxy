# Public browser configuration only.
# Copy this file to .env.local and replace placeholders.
# Never put real secrets in Git.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# SERVER-ONLY — do not prefix with NEXT_PUBLIC_
# Required later for user provisioning (Phase 3 AUTH-003 / AUTH-011).
# Must never appear in client components, browser bundles, or API responses.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# First admin bootstrap (scripts/bootstrap-admin.mjs). Do not commit real values.
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Optional E2E (QA-001). Use a dedicated staging project. Never commit real values.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_BASE_URL=http://127.0.0.1:3000
